{
  "name": "@jamie-bitflight/git-forensics-mcp",
  "version": "0.5.2",
  "packageManager": "pnpm@9.15.9",
  "description": "MCP server for deep git repository analysis and investigation, providing insights into branch relationships, merge strategies, and development patterns",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "git-forensics-mcp": "./build/index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Jamie-BitFlight/git-forensics-mcp.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && chmod +x build/index.js",
    "start": "ts-node src/index.ts",
    "validate": "tsx scripts/validate.ts",
    "inspect:method": "mcp-inspector --cli pnpm start --method",
    "tools:list": "pnpm inspect:method tools/list",
    "prepare": "husky",
    "prettier": "prettier",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-angular": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@commitlint/config-nx-scopes": "^21.0.1",
    "@commitlint/cz-commitlint": "^21.0.1",
    "@commitlint/prompt-cli": "^21.0.1",
    "@modelcontextprotocol/inspector": "^0.21.2",
    "@nx/js": "22.7.2",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.15.33",
    "@swc/helpers": "~0.5.21",
    "@types/node": "^25.9.1",
    "commitlint": "^21.0.1",
    "husky": "^9.1.7",
    "nx": "22.7.7",
    "prettier": "^3.8.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3"
  },
  "nx": {}
}
